{
  "info": {
    "name": "ScrumBoard API - IDEASGROUP",
    "description": "Coleccion de prueba del backend. Ejecutar las peticiones en orden: el login guarda el token y cada alta guarda su id en las variables de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "assigneeId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "columnAId", "value": "" },
    { "key": "columnBId", "value": "" },
    { "key": "taskAId", "value": "" },
    { "key": "taskBId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.test('devuelve token', () => pm.expect(body.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ideasgroup.test\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login (dev) - segunda sesion",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dev@ideasgroup.test\",\n  \"password\": \"Dev123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login invalido (401 esperado)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ideasgroup.test\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Usuarios (para asignar responsables)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const users = pm.response.json();",
                  "const dev = users.find(u => u.email === 'dev@ideasgroup.test') || users[0];",
                  "pm.collectionVariables.set('assigneeId', dev.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/users", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users"] }
          }
        },
        {
          "name": "Sin token (401 esperado)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        }
      ]
    },
    {
      "name": "2. Proyectos",
      "item": [
        {
          "name": "Crear proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('projectId', pm.response.json().id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plataforma Scrum\",\n  \"description\": \"Modulo inicial de gestion agil\",\n  \"startDate\": \"2026-01-15\",\n  \"plannedEndDate\": \"2026-06-30\",\n  \"status\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "Listar con paginacion y filtro parcial",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?name=scrum&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "name", "value": "scrum" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Obtener proyecto",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Actualizar proyecto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plataforma Scrum v2\",\n  \"description\": \"Descripcion actualizada\",\n  \"startDate\": \"2026-01-15\",\n  \"plannedEndDate\": \"2026-08-31\",\n  \"status\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Tablero completo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/board",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "board"]
            }
          }
        },
        {
          "name": "Eliminar proyecto",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Columnas",
      "item": [
        {
          "name": "Crear columna A (Backlog)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('columnAId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Backlog\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "columns"]
            }
          }
        },
        {
          "name": "Crear columna B (En progreso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('columnBId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"En progreso\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "columns"]
            }
          }
        },
        {
          "name": "Listar columnas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/columns",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "columns"]
            }
          }
        },
        {
          "name": "Renombrar columna",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pendiente\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/columns/{{columnAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "columns", "{{columnAId}}"]
            }
          }
        },
        {
          "name": "Reordenar columnas",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderedColumnIds\": [\"{{columnBId}}\", \"{{columnAId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/columns/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "columns", "order"]
            }
          }
        },
        {
          "name": "Eliminar columna con tareas (409 esperado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('la regla de negocio bloquea el borrado', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/columns/{{columnAId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "columns", "{{columnAId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Tareas y arrastre",
      "item": [
        {
          "name": "Crear tarea A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('taskAId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"{{columnAId}}\",\n  \"title\": \"Disenar modelo de datos\",\n  \"description\": \"ER y migraciones incrementales\",\n  \"priority\": 2,\n  \"assigneeId\": \"{{assigneeId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Crear tarea B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('taskBId', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"{{columnAId}}\",\n  \"title\": \"Implementar login JWT\",\n  \"priority\": 3,\n  \"assigneeId\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
          }
        },
        {
          "name": "Listar tareas de una columna",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/columns/{{columnAId}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "columns", "{{columnAId}}", "tasks"]
            }
          }
        },
        {
          "name": "Actualizar tarea",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implementar login JWT y refresh\",\n  \"description\": \"Incluye interceptor\",\n  \"priority\": 3,\n  \"assigneeId\": \"{{assigneeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskBId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskBId}}"]
            }
          }
        },
        {
          "name": "Mover tarea a otra columna (drag and drop)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('cambia de columna', () => pm.expect(body.columnId).to.eql(pm.collectionVariables.get('columnBId')));",
                  "console.log('nueva posicion:', body.position);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetColumnId\": \"{{columnBId}}\",\n  \"previousTaskId\": null,\n  \"nextTaskId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskBId}}/position",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskBId}}", "position"]
            }
          }
        },
        {
          "name": "Reordenar dentro de la columna (punto medio)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetColumnId\": \"{{columnAId}}\",\n  \"previousTaskId\": \"{{taskAId}}\",\n  \"nextTaskId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskBId}}/position",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskBId}}", "position"]
            }
          }
        },
        {
          "name": "Eliminar tarea",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskBId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskBId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Reportes",
      "item": [
        {
          "name": "Formatos disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/report/formats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "report", "formats"]
            }
          }
        },
        {
          "name": "Descargar PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/report?format=pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "report"],
              "query": [{ "key": "format", "value": "pdf" }]
            }
          }
        },
        {
          "name": "Descargar Excel",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/report?format=xlsx",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "report"],
              "query": [{ "key": "format", "value": "xlsx" }]
            }
          }
        },
        {
          "name": "Formato no soportado (400 esperado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/report?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "report"],
              "query": [{ "key": "format", "value": "csv" }]
            }
          }
        }
      ]
    }
  ]
}
