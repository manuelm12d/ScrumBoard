# ---------------------------------------------------------------------------
# Copia este archivo como .env antes de levantar la solucion:  cp .env.example .env
# Los valores por defecto estan completos a proposito para agilizar la ejecucion
# del evaluador (requisito 6.1). No usar estos valores en produccion.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=scrumboard
POSTGRES_USER=scrumboard
POSTGRES_PASSWORD=POSEYD0M26
# Puerto publicado en el host. Cambialo a 5433 si ya tienes Postgres local.
POSTGRES_PORT=5432

# --- API -------------------------------------------------------------------
API_PORT=8080
WEB_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# Cadena de conexion usada por la API DENTRO de docker compose (host = nombre del servicio).
ConnectionStrings__Default=Host=db;Port=5432;Database=scrumboard;Username=scrumboard;Password=POSEYD0M26

# Cadena equivalente cuando la API corre en el host y solo Postgres esta en Docker
# (modo desarrollo). Ver README, seccion "Arranque en modo desarrollo".
ConnectionStrings__DefaultLocal=Host=localhost;Port=5432;Database=scrumboard;Username=scrumboard;Password=POSEYD0M26

# --- JWT -------------------------------------------------------------------
Jwt__Issuer=scrumboard-api
Jwt__Audience=scrumboard-spa
# Debe tener al menos 32 caracteres (HMAC-SHA256).
Jwt__Key=GtDf8M9TwoCo4YFY7G9rx7c32nwSDIAb
Jwt__ExpiresMinutes=480

# --- Seguridad de contrasenas ---------------------------------------------
# El pepper NO se guarda en la base de datos. Los hashes de la migracion semilla
# fueron generados con este valor: si lo cambias, los usuarios precargados dejan
# de poder iniciar sesion (ver README).
Security__PasswordPepper=dev-pepper-ideasgroup-2026

# --- CORS ------------------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=http://localhost:8081
